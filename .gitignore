# Build artifacts
/build/
/dist/
/data/screenshots/*.png
/obj-*/
*.o
*.a
*.lo
*.la
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
*.exp
*.lib
*.ilk
*.idb
*.pch
*.gch
*.d

# Autotools / configure artifacts (if introduced later)
/configure.lineno
/config.cache
/config.log
/config.status
/autom4te.cache/

# Meson / Ninja (likely build system for a GTK4/C project)
/builddir/
/builddir-release/
/builddir-wgpu/
/builddir-verify/
/release-build/
/build-*/

# iOS build artifacts: the cross-compile staging + generated Xcode project.
/ios/.build/
/ios/App/vendor/
/ios/App/Nordstjernen.xcodeproj/
/ios/sysroot/
# Downloaded wgpu-native release blobs (headers are vendored; the library is fetched)
/third_party/wgpu-native/dl/
.ninja_deps
.ninja_log
build.ninja
compile_commands.json

# Meson auto-downloaded subprojects (wrap files only are committed).
# The default QuickJS and lexbor live in src/, not subprojects/; the
# original QuickJS (-Dquickjs=quickjs) is fetched into subprojects/quickjs/.
/subprojects/packagecache/
/subprojects/quickjs/
/subprojects/wgpu-native-*/
/subprojects/simde-*/

# CMake (in case)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/

# Editor / OS
*~
*.swp
*.swo
.DS_Store
Thumbs.db
.idea/
.vscode/
*.sublime-*

# Logs / scratch
*.log
/.scratch/
/.cache/
/local-build.log

# Local dev artifacts (Windows/MSYS2 box)
/.tmp/
/.ccache/
/scripts/_msys_*

# Local Claude settings (allow .claude/settings.json if you want shared)
.claude/settings.local.json

# Claude harness state
/.claude/
perf.data
/builddir-stock/
__pycache__/

# Site benchmark captures and the Chrome-side node install
/sitebench-out/
/builddir-asan/
/scripts/sitebench/node_modules/
/scripts/sitebench/package-lock.json
/builddir-dbg/

# Signing material, credentials and local browsing data must never be committed
*.jks
*.keystore
keystore.properties
local.properties
*.p8
*.p12
*.pfx
*.key
*.pem
!/android/app/src/main/res/raw/cacert.pem
*.mobileprovision
.env
cookies*.txt
*.har
*.sqlite
*.sqlite3
vgcore.*
*.dmp
sitebench-out/
