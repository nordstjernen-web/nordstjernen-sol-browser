+bool
+wasm_runtime_link_import_global(WASMModuleCommon *const module,
+                                int32 import_index, const wasm_val_t *value)
+{
+#if WASM_ENABLE_INTERP != 0
+    if (module && value && module->module_type == Wasm_Module_Bytecode) {
+        WASMModule *wasm_module = (WASMModule *)module;
+        WASMImport *wasm_import;
+
+        if ((uint32)import_index >= wasm_module->import_count)
+            return false;
+        wasm_import = &wasm_module->imports[import_index];
+        if (wasm_import->kind != WASM_IMPORT_EXPORT_KIND_GLOBAL)
+            return false;
+        switch (value->kind) {
+            case WASM_I32:
+                wasm_import->u.global.global_data_linked.i32 = value->of.i32;
+                break;
+            case WASM_I64:
+                wasm_import->u.global.global_data_linked.i64 = value->of.i64;
+                break;
+            case WASM_F32:
+                wasm_import->u.global.global_data_linked.f32 = value->of.f32;
+                break;
+            case WASM_F64:
+                wasm_import->u.global.global_data_linked.f64 = value->of.f64;
+                break;
+            default:
+                return false;
+        }
+        wasm_import->u.global.is_linked = true;
+        return true;
+    }
+#endif
+    (void)module;
+    (void)import_index;
+    (void)value;
+    return false;
+}
+
+int32
+wasm_runtime_get_data_segment_count(WASMModuleCommon *const module)
+{
+#if WASM_ENABLE_INTERP != 0
+    if (module && module->module_type == Wasm_Module_Bytecode) {
+        return (int32)((WASMModule *)module)->data_seg_count;
+    }
+#endif
+    return -1;
+}
+
+bool
+wasm_runtime_get_data_segment_range(WASMModuleCommon *const module,
+                                    int32 index, uint64 *out_offset,
+                                    uint32 *out_length)
+{
+#if WASM_ENABLE_INTERP != 0
+    if (module && out_offset && out_length
+        && module->module_type == Wasm_Module_Bytecode) {
+        WASMModule *wasm_module = (WASMModule *)module;
+        WASMDataSeg *data_seg;
+
+        if ((uint32)index >= wasm_module->data_seg_count)
+            return false;
+        data_seg = wasm_module->data_segments[index];
+#if WASM_ENABLE_BULK_MEMORY != 0
+        if (data_seg->is_passive) {
+            *out_offset = 0;
+            *out_length = 0;
+            return true;
+        }
+#endif
+        switch (data_seg->base_offset.init_expr_type) {
+            case INIT_EXPR_TYPE_I32_CONST:
+                *out_offset = (uint64)(uint32)data_seg->base_offset.u.unary.v.i32;
+                break;
+            case INIT_EXPR_TYPE_I64_CONST:
+                *out_offset = (uint64)data_seg->base_offset.u.unary.v.i64;
+                break;
+            default:
+                return false;
+        }
+        *out_length = data_seg->data_length;
+        return true;
+    }
+#endif
+    (void)module;
+    (void)index;
+    (void)out_offset;
+    (void)out_length;
+    return false;
+}
