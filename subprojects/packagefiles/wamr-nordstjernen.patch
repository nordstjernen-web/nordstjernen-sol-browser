+static int32
+eh_add_entry(WASMFunction *func, char *error_buf, uint32 error_buf_size)
+{
+    WASMFastEHEntry *entry;
+
+    if (func->eh_entry_count == func->eh_entry_capacity) {
+        uint32 capacity =
+            func->eh_entry_capacity ? func->eh_entry_capacity * 2 : 4;
+        WASMFastEHEntry *entries =
+            loader_malloc(sizeof(WASMFastEHEntry) * (uint64)capacity,
+                          error_buf, error_buf_size);
+        if (!entries)
+            return -1;
+        if (func->eh_entries) {
+            bh_memcpy_s(entries, sizeof(WASMFastEHEntry) * capacity,
+                        func->eh_entries,
+                        sizeof(WASMFastEHEntry) * func->eh_entry_count);
+            wasm_runtime_free(func->eh_entries);
+        }
+        func->eh_entries = entries;
+        func->eh_entry_capacity = capacity;
+    }
+    entry = &func->eh_entries[func->eh_entry_count];
+    memset(entry, 0, sizeof(WASMFastEHEntry));
+    entry->outer = -1;
+    entry->first_clause = -1;
+    entry->last_clause = -1;
+    return (int32)func->eh_entry_count++;
+}
+
+static bool
+eh_add_clause(WASMFunction *func, int32 entry_index, uint32 tag_index,
+              uint8 *handler, uint16 exn_slot, uint16 payload_slot,
+              char *error_buf, uint32 error_buf_size)
+{
+    WASMFastEHClause *clause;
+    WASMFastEHEntry *entry;
+    int32 clause_index;
+
+    if (func->eh_clause_count == func->eh_clause_capacity) {
+        uint32 capacity =
+            func->eh_clause_capacity ? func->eh_clause_capacity * 2 : 4;
+        WASMFastEHClause *clauses =
+            loader_malloc(sizeof(WASMFastEHClause) * (uint64)capacity,
+                          error_buf, error_buf_size);
+        if (!clauses)
+            return false;
+        if (func->eh_clauses) {
+            bh_memcpy_s(clauses, sizeof(WASMFastEHClause) * capacity,
+                        func->eh_clauses,
+                        sizeof(WASMFastEHClause) * func->eh_clause_count);
+            wasm_runtime_free(func->eh_clauses);
+        }
+        func->eh_clauses = clauses;
+        func->eh_clause_capacity = capacity;
+    }
+    clause_index = (int32)func->eh_clause_count++;
+    clause = &func->eh_clauses[clause_index];
+    clause->tag_index = tag_index;
+    clause->handler = handler;
+    clause->exn_slot = exn_slot;
+    clause->payload_slot = payload_slot;
+    clause->next = -1;
+
+    entry = &func->eh_entries[entry_index];
+    if (entry->last_clause >= 0)
+        func->eh_clauses[entry->last_clause].next = clause_index;
+    else
+        entry->first_clause = clause_index;
+    entry->last_clause = clause_index;
+    return true;
